{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "..\\backend\\.venv\\Scripts\\python.exe app.py",
            "options": {
                "cwd": "${workspaceFolder}/backend"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "python",
                "fileLocation": ["relative", "${workspaceFolder}/backend"],
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "INFO:     Uvicorn running on",
                    "endsPattern": "INFO:     Uvicorn running on"
                }
            },
            "presentation": {
                "reveal": "always",
                "group": "app"
            }
        }
    ]
}
